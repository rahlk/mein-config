layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zjstatus" {
                format_left   "{mode} {tabs}"
                format_center ""
                format_right  "{pipe_zjstatus_hints}{datetime}#[bg=#d3869b,fg=#282828,bold] {session} "
                format_space  ""

                      pipe_zjstatus_hints_format "#[bg=#d3869b,fg=#282828,bold] {output} "

                border_enabled  "false"
                border_char     "─"
                border_format   "#[fg=#928374]{char}"
                border_position "top"

                hide_frame_for_single_pane "true"

                mode_locked      "#[bg=#d3869b,fg=#282828,bold]  LOCK "
                mode_normal      "#[bg=#ebdbb2,fg=#282828,bold]  NORMAL "
                mode_resize      "#[bg=#fb4934,fg=#282828,bold]  RESIZE "
                mode_pane        "#[bg=#83a598,fg=#282828,bold]  PANE"
                mode_move        "#[bg=#8ec07c,fg=#282828,bold]  MOVE "
                mode_tab         "#[bg=#fabd2f,fg=#282828,bold]  TAB "
                mode_scroll      "#[bg=#ebdbb2,fg=#282828,bold]  SCROLL "
                mode_search      "#[bg=#fabd2f,fg=#282828,bold]  SEARCH "
                mode_entersearch "#[bg=#fabd2f,fg=#282828,bold]  ENTER SEARCH "
                mode_renametab   "#[bg=#d3869b,fg=#282828,bold]  RENAME TAB "
                mode_renamepane  "#[bg=#d3869b,fg=#282828,bold]  RENAME PANE "
                mode_session     "#[bg=#fb4934,fg=#282828,bold]  SESSION "
                mode_tmux        "#[bg=#ebdbb2,fg=#282828,bold]  TMUX "

                tab_active              "#[bg=#d3869b,fg=#282828,bold] {index} {name} "
                tab_active_fullscreen   "#[bg=#d3869b,fg=#282828,bold] {fullscreen_indicator} {index} {name} "
                tab_active_sync         "#[bg=#d3869b,fg=#282828,bold] {sync_indicator} {index} {name} "

                tab_normal              "#[fg=#928374,bold] {index} {name} "
                tab_normal_fullscreen   "#[fg=#928374,bold] {fullscreen_indicator} {index} {name} "
                tab_normal_sync         "#[fg=#928374,bold] {sync_indicator} {index} {name} "

                tab_separator " "

                tab_sync_indicator       "󰓦"
                tab_fullscreen_indicator "󰊓"
                tab_floating_indicator   "⬚"

                tab_rename              "#[bg=#83a598,fg=#282828,bold] {index} {name} {floating_indicator} "

                tab_display_count         "9"
                tab_truncate_start_format "#[fg=#fabd2f]  +{count}  "
                tab_truncate_end_format   "#[fg=#fabd2f]   +{count} "

                datetime        "#[fg=#928374,bold] {format} "
                datetime_format "%d %b %H:%M"
                datetime_timezone "America/New_York"
            }
        }
    }
    tab name=""
}
